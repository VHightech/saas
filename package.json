{
  "name": "acqdash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "concurrently \"npm run dev\" \"npx cloudflared tunnel --url http://localhost:3000\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "r2:last": "tsx scripts/r2-last-upload.ts",
    "r2:fix": "tsx scripts/r2-upload-missing.ts",
    "r2:check": "tsx scripts/r2-check-names.ts",
    "r2:sign": "tsx scripts/r2-sign.ts",
    "r2:compress": "tsx scripts/r2-compress.ts",
    "backfill": "tsx scripts/backfill-from-csv.ts",
    "collect-7z": "tsx scripts/collect-clienti-7z.ts",
    "relink": "tsx scripts/relink-bills-from-r2.ts",
    "import": "tsx scripts/import-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/import-helpers.test.ts tests/unit/field-fix.test.ts tests/unit/mailer-config.test.ts tests/unit/consumption-advice.test.ts",
    "presentation": "node scripts/build-presentation.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "fix:consumo": "tsx scripts/fix-field-from-csv.ts --field consumo",
    "fix:field": "tsx scripts/fix-field-from-csv.ts",
    "mail:check": "tsx scripts/check-smtp.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@marsidev/react-turnstile": "^1.5.1",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "7zip-bin": "^5.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "node-7z": "^3.0.0",
    "nodemailer": "^9.0.6",
    "postcss": "^8.5.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "resend": "^6.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/node-7z": "^2.1.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
